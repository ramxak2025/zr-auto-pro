{
  "name": "zr-auto-pro",
  "version": "1.0.0",
  "private": true,
  "description": "CRM + Warehouse + Financial accounting for auto service",
  "scripts": {
    "backend:dev": "cd backend && npm run start:dev",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "frontend:build": "cd frontend && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../mobile && npm install",
    "mobile:start": "cd mobile && expo start",
    "mobile:android": "cd mobile && expo run:android",
    "mobile:build:apk": "./scripts/build-apk.sh debug",
    "mobile:build:release": "./scripts/build-apk.sh release"
  }
}
