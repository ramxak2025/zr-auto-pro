{
  "expo": {
    "name": "Autexa",
    "slug": "autexa-mobile",
    "owner": "ramxak",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autexa.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению нужен доступ к камере для фотографирования документов и автомобилей",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к галерее для выбора фотографий"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.autexa.mobile",
      "versionCode": 2
    },
    "extra": {
      "apiUrl": "https://autexa.pw/api",
      "eas": {
        "projectId": "2d08b9be-9503-4e31-9198-8ec7093e44d7"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ]
  }
}
