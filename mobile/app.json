{
  "expo": {
    "name": "Autexa",
    "slug": "autexa-mobile",
    "owner": "ramxak",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autexa.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению нужен доступ к камере для фотографирования документов и автомобилей",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к галерее для выбора фотографий",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["tel", "telprompt"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.autexa.mobile",
      "versionCode": 4
    },
    "updates": {
      "url": "https://u.expo.dev/2d08b9be-9503-4e31-9198-8ec7093e44d7",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiUrl": "https://autexa.pw/api",
      "eas": {
        "projectId": "2d08b9be-9503-4e31-9198-8ec7093e44d7"
      }
    },
    "plugins": [
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "extraPodfileProps": {
              "ENABLE_USER_SCRIPT_SANDBOXING": "NO"
            }
          }
        }
      ]
    ]
  }
}
