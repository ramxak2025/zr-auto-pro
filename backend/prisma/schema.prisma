generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  superadmin
  director
  admin
  master
}

enum PaymentMethod {
  cash
  card
  warranty
  cash_card
}

enum StockMovementType {
  income
  expense
  writeoff
  inventory
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum WorkModeType {
  rotating
  weekly
}

enum LateStatus {
  on_time
  late_minor
  late_major
}

// ==================== MODELS ====================

model Tenant {
  id               String    @id @default(uuid())
  name             String
  slug             String?   @unique
  phone            String?
  address          String?
  email            String?
  description      String?
  logo             String?
  isActive         Boolean   @default(true)
  maxUsers         Int       @default(10)
  subscriptionEnd  DateTime?
  subscriptionNote String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users          User[]
  clients        Client[]
  cars           Car[]
  services       Service[]
  products       Product[]
  checks         Check[]
  suppliers      Supplier[]
  deliveries     Delivery[]
  shifts         Shift[]
  scheduleEntries ScheduleEntry[]
  workModes      WorkMode[]
  stockMovements StockMovement[]
  supplierPayments SupplierPayment[]

  @@map("tenants")
}

model User {
  id            String          @id @default(uuid())
  phone         String          @unique
  password      String
  fullName      String
  username      String?
  role          UserRole        @default(master)
  salaryPercent Float           @default(0)
  permissions   Json            @default("{}")
  isActive      Boolean         @default(true)
  tenantId      String?
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  checksAsMaster    Check[]         @relation("CheckMaster")
  serviceLines      CheckServiceLine[] @relation("ServiceLineMaster")
  shifts            Shift[]
  scheduleEntries   ScheduleEntry[]

  @@map("users")
}

model Client {
  id       String  @id @default(uuid())
  fullName String
  phone    String
  comment  String?
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  cars   Car[]
  checks Check[]

  @@map("clients")
}

model Car {
  id          String  @id @default(uuid())
  plateNumber String
  makeModel   String
  comment     String?
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  checks Check[]

  @@map("cars")
}

model Service {
  id           String  @id @default(uuid())
  name         String
  category     String?
  defaultPrice Float   @default(0)
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  checkLines CheckServiceLine[]

  @@map("services")
}

model Product {
  id        String  @id @default(uuid())
  name      String
  category  String?
  photo     String?
  costPrice Float   @default(0)
  sellPrice Float   @default(0)
  stock     Int     @default(0)
  minStock  Int     @default(0)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  checkLines     CheckProductLine[]
  stockMovements StockMovement[]
  deliveryItems  DeliveryItem[]

  @@map("products")
}

model Check {
  id              String        @id @default(uuid())
  number          Int
  date            DateTime      @default(now())
  masterId        String
  master          User          @relation("CheckMaster", fields: [masterId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  carId           String
  car             Car           @relation(fields: [carId], references: [id])
  mileage         Int?
  comment         String?
  discount        Float         @default(0)
  isDeferred      Boolean       @default(false)
  paymentMethod   PaymentMethod @default(cash)
  serviceTotal    Float         @default(0)
  productTotal    Float         @default(0)
  totalRevenue    Float         @default(0)
  productCostTotal Float        @default(0)
  serviceSalaryTotal Float      @default(0)
  totalCost       Float         @default(0)
  profit          Float         @default(0)
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  services CheckServiceLine[]
  products CheckProductLine[]

  @@map("checks")
}

model CheckServiceLine {
  id        String  @id @default(uuid())
  checkId   String
  check     Check   @relation(fields: [checkId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  masterId  String?
  master    User?   @relation("ServiceLineMaster", fields: [masterId], references: [id], onDelete: SetNull)
  name      String
  price     Float
  quantity  Int     @default(1)
  total     Float

  @@map("check_service_lines")
}

model CheckProductLine {
  id        String  @id @default(uuid())
  checkId   String
  check     Check   @relation(fields: [checkId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  sellPrice Float
  costPrice Float
  quantity  Int     @default(1)
  totalSell Float
  totalCost Float

  @@map("check_product_lines")
}

model Supplier {
  id            String  @id @default(uuid())
  name          String
  phone         String?
  contactPerson String?
  comment       String?
  totalPurchases Float  @default(0)
  totalPaid     Float   @default(0)
  currentDebt   Float   @default(0)
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  products   Product[]
  deliveries Delivery[]
  payments   SupplierPayment[]

  @@map("suppliers")
}

model Delivery {
  id            String        @id @default(uuid())
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date          DateTime      @default(now())
  totalAmount   Float         @default(0)
  paymentStatus PaymentStatus @default(unpaid)
  comment       String?
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items DeliveryItem[]

  @@map("deliveries")
}

model DeliveryItem {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  price      Float
  total      Float

  @@map("delivery_items")
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Float
  date       DateTime @default(now())
  comment    String?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("supplier_payments")
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String?
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@map("stock_movements")
}

model Shift {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @default(now())
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  isAutoClosed Boolean   @default(false)
  note         String?
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("shifts")
}

model ScheduleEntry {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  shiftStart       String
  shiftEnd         String
  isDayOff         Boolean     @default(false)
  actualArrival    String?
  lateMinutes      Int         @default(0)
  lateStatus       LateStatus?
  note             String?
  isManualOverride Boolean     @default(false)
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("schedule_entries")
}

model WorkMode {
  id         String       @id @default(uuid())
  name       String
  type       WorkModeType
  workDays   Int          @default(0)
  offDays    Int          @default(0)
  weekDays   Json         @default("[]")
  shiftStart String
  shiftEnd   String
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("work_modes")
}
