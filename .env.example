# Database
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change-me-in-production

# Frontend API URL (for Docker build)
# Use /api for production (nginx proxies to backend)
VITE_API_URL=/api

# S3 Storage (for product photos)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=zr-auto-pro
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Auto-deploy webhook
DEPLOY_SECRET=zr-auto-deploy-secret-change-me
DEPLOY_BRANCH=claude/redesign-from-scratch-5xQJz
