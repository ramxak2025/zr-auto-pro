# ══════════════════════════════════════════════════════════════════════
#  AUTEXA — Environment Variables
#  Copy to .env and fill in real values. NEVER commit .env itself.
# ══════════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ──────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── JWT (REQUIRED) ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_char_string

# ── Redis (for token blacklist + caching) ─────────────────────────────
# Set to empty or omit to fall back to in-memory (single-instance only)
REDIS_URL=redis://localhost:6379

# ── Frontend API URL (for Docker build) ───────────────────────────────
VITE_API_URL=/api

# ── CORS origins (comma-separated, backend) ──────────────────────────
CORS_ORIGIN=https://autexa.pw,https://www.autexa.pw

# ── S3 Storage (product photos) ──────────────────────────────────────
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=zr-auto-pro
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ── Expo / EAS Build (mobile APK) ────────────────────────────────────
EXPO_TOKEN=your-expo-token

# ── Sentry (error tracking) ──────────────────────────────────────────
# Create project at sentry.io, get DSN. Leave empty to disable.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Auto-deploy webhook (REQUIRED) ───────────────────────────────────
DEPLOY_SECRET=CHANGE_ME_webhook_secret
DEPLOY_BRANCH=master

# ── Деплой из готовых образов GHCR (опционально) ─────────────────────
# PAT (classic) от github.com/ramxak2025 с ЕДИНСТВЕННЫМ scope read:packages.
# Если задан в серверном .env — deploy.sh перестаёт собирать образы на VDS
# (тяжёлая сборка давала ~300% CPU) и скачивает готовые из GitHub Container
# Registry; их публикует .github/workflows/build-images.yml на каждый пуш.
# Пусто / строки нет = локальная сборка с кэшем слоёв (как раньше).
GHCR_READ_TOKEN=
# Сколько секунд деплой ждёт, пока CI опубликует образы ТЕКУЩЕГО коммита,
# прежде чем откатиться на локальную сборку (по умолчанию 480):
# GHCR_PULL_WAIT_S=480
