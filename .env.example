# ══════════════════════════════════════════════════════════════════════
#  AUTEXA — Environment Variables
#  Copy to .env and fill in real values. NEVER commit .env itself.
# ══════════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ──────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── JWT (REQUIRED) ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_char_string

# ── Redis (for token blacklist + caching) ─────────────────────────────
# Set to empty or omit to fall back to in-memory (single-instance only)
REDIS_URL=redis://localhost:6379

# ── Frontend API URL (for Docker build) ───────────────────────────────
VITE_API_URL=/api

# ── CORS origins (comma-separated, backend) ──────────────────────────
CORS_ORIGIN=https://autexa.pw,https://www.autexa.pw

# ── S3 Storage (product photos) ──────────────────────────────────────
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=zr-auto-pro
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ── Expo / EAS Build (mobile APK) ────────────────────────────────────
EXPO_TOKEN=your-expo-token

# ── Sentry (error tracking) ──────────────────────────────────────────
# Create project at sentry.io, get DSN. Leave empty to disable.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Auto-deploy webhook (REQUIRED) ───────────────────────────────────
DEPLOY_SECRET=CHANGE_ME_webhook_secret
DEPLOY_BRANCH=master

# ── Деплой из готовых образов GHCR (опционально) ─────────────────────
# PAT (classic) от github.com/ramxak2025 с ЕДИНСТВЕННЫМ scope read:packages.
# Если задан в серверном .env — deploy.sh перестаёт собирать образы на VDS
# (тяжёлая сборка давала ~300% CPU) и скачивает готовые из GitHub Container
# Registry; их публикует .github/workflows/build-images.yml на каждый пуш.
# Пусто / строки нет = локальная сборка с кэшем слоёв (как раньше).
GHCR_READ_TOKEN=
# Сколько секунд деплой ждёт, пока CI опубликует образы ТЕКУЩЕГО коммита,
# прежде чем откатиться на локальную сборку (по умолчанию 480):
# GHCR_PULL_WAIT_S=480

# ── Offsite-копия бэкапов в S3 (опционально) ─────────────────────────
# Локальные бэкапы (backups/) лежат на том же диске, что и прод —
# «сгорел VDS = потеряно всё». Если заданы ВСЕ четыре S3_BACKUP_*,
# backup.sh после каждого успешного локального бэкапа выгружает свежие
# pg_dump + uploads-архив в S3-совместимый бакет (докеризованный rclone,
# ничего ставить на сервер не нужно). Подходит любой S3-провайдер:
#   Beget Cloud S3:          https://s3.ru1.storage.beget.cloud
#   Selectel Object Storage: https://s3.storage.selcloud.ru
#   Yandex Object Storage:   https://storage.yandexcloud.net
# Бакет должен уже существовать (скрипт его НЕ создаёт). Пусто / строк
# нет = offsite выключен, бэкап работает как раньше. Ошибки offsite
# никогда не роняют бэкап/деплой. Инструкция: docs/OFFSITE_BACKUPS.md
S3_BACKUP_ENDPOINT=
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
# Сколько дней хранить offsite-копии (старше — удаляются после каждой
# выгрузки; по умолчанию 30):
# S3_BACKUP_RETENTION_DAYS=30

# ── RLS: второй рубеж изоляции тенантов (миграция 112) ──────────────────────
# Не задан → приложение работает одним суперпользовательским пулом (как
# раньше), политики RLS инертны. Задан (случайные 32+ символа) → тенантный
# трафик идёт через непривилегированную роль autexa_app под Row Level
# Security: забытый WHERE tenant_id больше не может отдать чужие данные.
# Включать ПОСЛЕ того, как миграция 112 применилась (любой деплой после неё).
# Откат: убрать переменную и перезапустить backend.
DB_APP_PASSWORD=
